Query:
  Summary:
     - Query ID: 0199147a-57a6-7416-88fe-3e67e6606417
     - Start Time: 2025-09-04 19:26:26
     - End Time: 2025-09-04 19:26:28
     - Total: 2s437ms
     - Query Type: Query
     - Query State: Finished
     - StarRocks Version: main-76cd8d3
     - User: root
     - Default Db: tpch
     - Sql Statement: SELECT
    p.p_name,
    SUM(l.l_extendedprice * (1 - l.l_discount)) AS revenue
FROM
    part p
JOIN
    lineitem l ON p.p_partkey = l.l_partkey
JOIN
    orders o ON l.l_orderkey = o.o_orderkey
WHERE
    o.o_orderdate >= '1997-01-01' AND o.o_orderdate < '1997-12-31'
GROUP BY
    p.p_name
ORDER BY
    revenue DESC
LIMIT 10;
     - Warehouse
