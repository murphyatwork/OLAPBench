     - User: root
     - Default Db: tpch
     - Sql Statement: SELECT 
    l_shipmode,
    COUNT(l_orderkey) AS order_count,
    SUM(l_extendedprice) AS total_revenue
FROM 
    lineitem
WHERE 
    l_shipdate BETWEEN '1997-01-01' AND '1997-12-31'
GROUP BY 
    l_shipmode
ORDER BY 
    total_revenue DESC;
