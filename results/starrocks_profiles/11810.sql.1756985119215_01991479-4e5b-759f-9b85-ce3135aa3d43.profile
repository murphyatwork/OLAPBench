     - Total: 820ms
     - Query Type: Query
     - Query State: Finished
     - StarRocks Version: main-76cd8d3
     - User: root
     - Default Db: tpch
     - Sql Statement: SELECT 
    l_shipmode,
    COUNT(*) AS number_of_orders,
    SUM(l_extendedprice * (1 - l_discount)) AS revenue
FROM 
    lineitem
WHERE 
    l_shipdate >= DATE '1996-01-01' 
    AND l_shipdate < DATE '1997-01-01'
GROUP BY 
    l_shipmode
ORDER BY 
    revenue DESC;
