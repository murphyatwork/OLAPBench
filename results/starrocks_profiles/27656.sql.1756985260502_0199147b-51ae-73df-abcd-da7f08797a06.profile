Query:
  Summary:
     - Query ID: 0199147b-51ae-73df-abcd-da7f08797a06
     - Start Time: 2025-09-04 19:27:30
     - End Time: 2025-09-04 19:27:40
     - Total: 10s165ms
     - Query Type: Query
     - Query State: Error
     - StarRocks Version: main-76cd8d3
     - User: root
     - Default Db: tpch
     - Sql Statement: SELECT 
    p.p_name,
    COUNT(DISTINCT ps.ps_suppkey) AS supplier_count,
    SUM(l.l_quantity) AS total_quantity,
    AVG(p.p_retailprice) AS avg_price,
    group_concat(DISTINCT s.s_name SEPARATOR ', ') AS supplier_names,
    RANK() OVER (PARTITION BY p.p_type ORDER BY SUM(l.l_extendedprice) DESC) AS price_rank
FROM 
    part p
JOIN 
    partsupp ps ON p.p_partkey = ps.ps_partkey
JOIN 
    supplier s ON ps.ps_suppkey = s.s_suppkey
JOIN 
    lineitem l ON p.p_partkey = l.l_partkey
JOIN 
    orders o ON l.l_orderkey = o.o_orderkey
JOIN 
    customer c ON o.o_custkey = c.c_custkey
GROUP BY 
    p.p_name, p.p_type
HAVING 
    SUM(l.l_quantity) > 100
ORDER BY 
    price_rank
LIMIT 10;
     - Warehouse
