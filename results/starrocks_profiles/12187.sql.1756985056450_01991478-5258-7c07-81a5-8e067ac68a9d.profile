Query:
  Summary:
     - Query ID: 01991478-5258-7c07-81a5-8e067ac68a9d
     - Start Time: 2025-09-04 19:24:13
     - End Time: 2025-09-04 19:24:16
     - Total: 2s571ms
     - Query Type: Query
     - Query State: Finished
     - StarRocks Version: main-76cd8d3
     - User: root
     - Default Db: tpch
     - Sql Statement: SELECT
    n_name,
    SUM(l_extendedprice * (1 - l_discount)) AS total_revenue
FROM
    lineitem
JOIN
    orders ON l_orderkey = o_orderkey
JOIN
    customer ON o_custkey = c_custkey
JOIN
    supplier ON l_suppkey = s_suppkey
JOIN
    partsupp ON l_partkey = ps_partkey AND s_suppkey = ps_suppkey
JOIN
    nation ON c_nationkey = n_nationkey
WHERE
    l_shipdate >= DATE '1995-01-01'
    AND l_shipdate < DATE '1996-01-01'
GROUP BY
    n_name
ORDER BY
    total_revenue DESC;
     - Warehouse
