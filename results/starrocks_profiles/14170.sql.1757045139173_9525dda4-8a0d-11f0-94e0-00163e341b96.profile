     - User: root
     - Default Db: tpch
     - Sql Statement: SELECT l_partkey, SUM(l_extendedprice * (1 - l_discount)) AS revenue
FROM lineitem
WHERE l_shipdate >= DATE '1997-01-01'
  AND l_shipdate < DATE '1997-02-01'
GROUP BY l_partkey
ORDER BY revenue DESC
LIMIT 10;
