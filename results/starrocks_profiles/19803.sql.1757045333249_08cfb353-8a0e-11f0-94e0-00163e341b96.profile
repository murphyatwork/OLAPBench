     - User: root
     - Default Db: tpch
     - Sql Statement: SELECT l_orderkey, SUM(l_extendedprice * (1 - l_discount)) AS total_revenue
FROM lineitem
WHERE l_shipdate >= '1995-01-01' AND l_shipdate <= '1995-12-31'
GROUP BY l_orderkey
ORDER BY total_revenue DESC
LIMIT 10;
