     - User: root
     - Default Db: tpch
     - Sql Statement: SELECT p_brand, SUM(l_extendedprice * (1 - l_discount)) AS total_revenue
FROM part
JOIN lineitem ON p_partkey = l_partkey
GROUP BY p_brand
ORDER BY total_revenue DESC;
