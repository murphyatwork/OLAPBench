Query:
  Summary:
     - Query ID: 0199147b-79df-77f8-8a74-94efc6d7bc3a
     - Start Time: 2025-09-04 19:27:40
     - End Time: 2025-09-04 19:27:45
     - Total: 4s499ms
     - Query Type: Query
     - Query State: Finished
     - StarRocks Version: main-76cd8d3
     - User: root
     - Default Db: tpch
     - Sql Statement: SELECT
    p.p_name,
    SUM(l.l_quantity) AS total_quantity,
    SUM(l.l_extendedprice) AS total_revenue
FROM
    part p
JOIN
    lineitem l ON p.p_partkey = l.l_partkey
JOIN
    supplier s ON l.l_suppkey = s.s_suppkey
JOIN
    partsupp ps ON p.p_partkey = ps.ps_partkey AND s.s_suppkey = ps.ps_suppkey
JOIN
    nation n ON s.s_nationkey = n.n_nationkey
JOIN
    region r ON n.n_regionkey = r.r_regionkey
WHERE
    r.r_name = 'ASIA'
GROUP BY
    p.p_name
ORDER BY
    total_revenue DESC
LIMIT 10;
     - Warehouse
